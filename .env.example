# Junko-Web environment variables (copy to .env.local — never commit secrets)

# --- Phase 1: Firestore seed / admin bootstrap (local Node scripts only) ---
# Staging Firebase project only for Phase 1. Production Firebase is out of scope.

# Option A: inline JSON (escape newlines if needed; prefer Option B locally)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B: path to downloaded service account key (gitignored)
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/junko-web-staging-service-account.json

# --- Phase 3+ (placeholders; not used by public site in Phase 1) ---
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Future catalog cutover (not implemented in Phase 1)
# CATALOG_SOURCE=file
