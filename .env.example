# Junko-Web environment variables (copy to .env.local — never commit secrets)

# Catalog source: file (default, products.ts) | firestore (staging/preview)
CATALOG_SOURCE=file

# --- Server-only (required when CATALOG_SOURCE=firestore on Preview/local) ---
# FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/junko-web-staging-service-account.json
# FIREBASE_PROJECT_ID=junko-web-staging

# --- Production seed guard (Phase 4 ops only; never in Vercel for routine deploys) ---
# CATALOG_SEED_CONFIRM=yes
# CATALOG_SEED_EXPECTED_PROJECT=your-production-firebase-project-id

# --- Client Firebase (Phase 6+ admin UI / manual revalidate tests) ---
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
