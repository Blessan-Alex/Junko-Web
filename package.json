{
  "name": "junko-web-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "catalog:snapshot": "node scripts/catalog-snapshot.cjs",
    "catalog:parity": "node scripts/catalog-parity.cjs",
    "catalog:seed": "node scripts/catalog-seed.cjs",
    "catalog:seed:production": "node scripts/catalog-seed.cjs --confirm-production",
    "catalog:rebuild-projection": "npx tsx scripts/rebuild-catalog-projection.mjs",
    "catalog:rebuild-projection:production": "npx tsx scripts/rebuild-catalog-projection.mjs --confirm-production --expected-project-id=junko-web-final",
    "catalog:phase1-seo:production": "node scripts/catalog/phase1-seo-products.mjs --confirm-production --expected-project-id=junko-web-final",
    "catalog:phase1-seo:verify": "node scripts/catalog/verify-phase1-firestore.mjs",
    "seo:audit": "node scripts/seo/audit-metadata.mjs",
    "seo:assert": "node scripts/seo/assert-product-seo.mjs",
    "catalog:phase2-seo:production": "node scripts/catalog/phase2-seo-metadata.mjs --confirm-production --expected-project-id=junko-web-final",
    "blob:migrate:dry-run": "node scripts/blob-migrate-catalog.cjs --dry-run",
    "blob:migrate": "node scripts/blob-migrate-catalog.cjs --confirm",
    "blob:migrate:production": "node scripts/blob-migrate-catalog.cjs --confirm --confirm-production --expected-project-id=junko-web-final"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "firebase": "^13.0.0",
    "firebase-admin": "^13.4.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
